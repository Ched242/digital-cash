# Supabase public configuration (publishable key is safe for browser/mobile clients)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy compatibility only; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side secret key only. Never expose or commit a real value.
SUPABASE_SECRET_KEY=
# Legacy server key compatibility; migrate to SUPABASE_SECRET_KEY when available
SUPABASE_SERVICE_ROLE_KEY=

# Payments — select and configure only providers for which you have an official merchant account.
PAYMENT_PROVIDER=
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Mobile money providers (credentials are server-side only)
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_URL=
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_PIN=
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

# International payment providers (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Digital goods / airtime / gift-card aggregator (provider-specific adapter required)
DIGITAL_GOODS_PROVIDER=
DIGITAL_GOODS_API_BASE_URL=
DIGITAL_GOODS_API_KEY=
DIGITAL_GOODS_API_SECRET=
DIGITAL_GOODS_WEBHOOK_SECRET=

# Notifications
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
TERMII_API_KEY=
TERMII_BASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
